# Local development configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5435/transactions
REDIS_URL=redis://localhost:6379/0

# Docker Compose configuration
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/transactions
DOCKER_REDIS_URL=redis://redis:6379/0

# PostgreSQL container configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transactions

TRANSACTION_QUEUE_NAME=transactions
PROCESSING_DELAY_SECONDS=30
RECOVERY_INTERVAL_SECONDS=60
STALE_TRANSACTION_SECONDS=120
WORKER_COUNT=2
