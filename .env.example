# Local development configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5435/transactions
REDIS_URL=redis://localhost:6379/0

# Docker Compose configuration
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/transactions
DOCKER_REDIS_URL=redis://redis:6379/0

# PostgreSQL container configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_DB=transactions
